{
  "experiment_name": "rare_class_sampling_v1",
  "seed": 42,
  "dataset_root": "data/severstal-steel-defect-detection",
  "prepared_dir": "experiments/severstal_segmentation/prepared",
  "image_width": 512,
  "image_height": 128,
  "batch_size": 2,
  "epochs": 5,
  "early_stopping_patience": 2,
  "learning_rate": 0.001,
  "num_workers": 0,
  "threshold": 0.5,
  "base_channels": 16,
  "device": "auto",
  "loss": "0.5 * BCEWithLogitsLoss + 0.5 * soft Dice loss",
  "sampling": {
    "strategy": "all positive images once, then weighted extra positive draws; uniform negative sample",
    "positive_fraction": 0.65,
    "max_appearances_per_image": 2,
    "rarity_power": 0.5
  }
}